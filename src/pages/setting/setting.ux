<template>
  <div class="page">

    <!-- 全屏滚动容器 -->
    <scroll class="content-full" scroll-y="true" bounces="true">

      <!-- ========== 方屏顶部栏 ========== -->
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">测试参数</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <!-- ========== 胶囊屏顶部栏 ========== -->
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <!-- ========== 内容区域 ========== -->
      <div class="scroll-inner">

        <!-- 单次分配大小 -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">单次分配</text>
            <text class="card-sub">{{ chunkSizeKB }} KB</text>
          </div>
        </div>

        <!-- 每批块数 -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">每批块数</text>
            <text class="card-sub">{{ batchSize }} 块</text>
          </div>
        </div>

        <!-- 填充模式 -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">填充模式</text>
            <text class="card-sub">全填 0xFF</text>
          </div>
        </div>

        <!-- 底部留白 -->
        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
/* ====== 系统模块导入 ====== */
import router from "@system.router"

/* ====== 测试参数常量 ====== */
var CHUNK_SIZE = 64 * 1024       /* 单次分配大小：64KB */
var BATCH_SIZE = 80               /* 每批分配块数：80块 ≈ 5MB */

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    chunkSizeKB: CHUNK_SIZE / 1024,   /* 转为KB展示 */
    batchSize: BATCH_SIZE
  },

  /** 页面初始化：启动时钟 */
  onInit() {
    this.updateTime()
    var self = this
    this.timer = setInterval(function() {
      self.updateTime()
    }, 1000)
  },

  /** 页面销毁：清除定时器 */
  onDestroy() {
    clearInterval(this.timer)
  },

  /** 更新顶栏时钟 */
  updateTime() {
    var d = new Date()
    var hh = ("0" + d.getHours()).slice(-2)
    var mm = ("0" + d.getMinutes()).slice(-2)
    this.nowTime = hh + ":" + mm
  },

  goBack() {
    router.back()
  }
}
</script>

