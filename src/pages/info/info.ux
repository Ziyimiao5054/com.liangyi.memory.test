<template>
  <div class="page">

    <!-- 全屏滚动容器 -->
    <scroll class="content-full" scroll-y="true" bounces="true">

      <!-- ========== 方屏顶部栏 ========== -->
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">设备信息</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <!-- ========== 胶囊屏顶部栏 ========== -->
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <!-- ========== 内容区域 ========== -->
      <div class="scroll-inner">

        <!-- 设备型号 -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">型号</text>
            <text class="card-sub">{{ deviceInfo.model }}</text>
          </div>
        </div>

        <!-- 设备代号（如"小米手环9"） -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">设备代号</text>
            <text class="card-sub">{{ deviceInfo.product }}</text>
          </div>
        </div>

        <!-- 操作系统 -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">系统</text>
            <text class="card-sub">{{ deviceInfo.osType }} {{ deviceInfo.osVersionName }}</text>
          </div>
        </div>

        <!-- 总存储 -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">总存储</text>
            <text class="card-sub">{{ deviceInfo.totalStorageStr }}</text>
          </div>
        </div>

        <!-- 可用存储 -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">可用存储</text>
            <text class="card-sub">{{ deviceInfo.availStorageStr }}</text>
          </div>
        </div>

        <!-- 底部留白 -->
        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
/* ====== 系统模块导入 ====== */
import router from "@system.router"
import device from "@system.device"

/** 格式化字节数为可读字符串 */
function fmtSize(bytes) {
  if (bytes >= 1024 * 1024 * 1024) return (bytes / (1024 * 1024 * 1024)).toFixed(1) + " GB"
  if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + " MB"
  if (bytes >= 1024) return (bytes / 1024).toFixed(1) + " KB"
  return bytes + " B"
}

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    deviceInfo: {
      model: "加载中…",
      product: "-",
      osType: "-",
      osVersionName: "-",
      totalStorageStr: "-",
      availStorageStr: "-"
    }
  },

  /** 页面初始化：启动时钟、加载设备信息 */
  onInit() {
    var self = this

    self.updateTime()
    self.timer = setInterval(function() {
      self.updateTime()
    }, 1000)

    /* 获取设备型号、代号、系统版本 */
    device.getInfo({
      success: function(ret) {
        self.deviceInfo.model = ret.model || "未知"
        var product = ret.product || ret.brand || ret.manufacturer || "-"
        product = product.replace("Xiaomi Smart Band", "小米手环")   /* 转中文 */
        self.deviceInfo.product = product
        self.deviceInfo.osType = ret.osType || "-"
        self.deviceInfo.osVersionName = ret.osVersionName || "-"
      },
      fail: function() {
        self.deviceInfo.model = "读取失败"
      }
    })

    /* 获取总存储 */
    device.getTotalStorage({
      success: function(ret) {
        self.deviceInfo.totalStorageStr = fmtSize(ret.totalStorage)
      },
      fail: function() {
        self.deviceInfo.totalStorageStr = "读取失败"
      }
    })

    /* 获取可用存储 */
    device.getAvailableStorage({
      success: function(ret) {
        self.deviceInfo.availStorageStr = fmtSize(ret.availableStorage)
      },
      fail: function() {
        self.deviceInfo.availStorageStr = "读取失败"
      }
    })
  },

  /** 页面销毁：清除定时器 */
  onDestroy() {
    clearInterval(this.timer)
  },

  /** 更新顶栏时钟 */
  updateTime() {
    var d = new Date()
    var hh = ("0" + d.getHours()).slice(-2)
    var mm = ("0" + d.getMinutes()).slice(-2)
    this.nowTime = hh + ":" + mm
  },

  goBack() {
    router.back()
  }
}
</script>

