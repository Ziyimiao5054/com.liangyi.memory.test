<template>
  <div class="page">

    <!-- 全屏滚动容器 -->
    <scroll class="content-full" scroll-y="true" bounces="true">

      <!-- ========== 方屏顶部栏 ========== -->
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">测试结果</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <!-- ========== 胶囊屏顶部栏 ========== -->
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <!-- ========== 内容区域 ========== -->
      <div class="scroll-inner">

        <!-- 填充内存卡片 -->
        <div class="card">
          <div class="card-left">
            <text class="card-label">填充内存</text>
            <text class="card-sub">{{ allocatedStr }}</text>    <!-- 动态显示分配量 -->
          </div>
        </div>

        <!-- 测试日志卡片（可点击跳转） -->
        <div class="card" onclick="viewLog">
          <div class="card-left">
            <text class="card-label">测试日志</text>
            <text class="card-sub">阅读上次测试日志</text>
          </div>
        </div>

        <!-- 设备信息卡片（可点击跳转） -->
        <div class="card" onclick="goInfo">
          <div class="card-left">
            <text class="card-label">设备信息</text>
            <text class="card-sub">关于此设备</text>
          </div>
        </div>

        <!-- 底部留白 -->
        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
/* ====== 系统模块导入 ====== */
import router from "@system.router"
import file from "@system.file"
import device from "@system.device"

var LOG_FILE = "internal://files/memtest_result.txt"   /* 日志文件路径 */

export default {
  private: {
    allocatedStr: "-",            /* 累计分配量（从日志解析） */
    deviceModel: "-",             /* 设备型号 */
    osVersion: "-",               /* 系统版本 */
    nowTime: "00:00",             /* 顶栏时钟 */
    timer: null                   /* 时钟定时器 */
  },

  /** 页面初始化：启动时钟、读取测试结果、获取设备信息 */
  onInit() {
    var self = this

    self.updateTime()
    self.timer = setInterval(function() {
      self.updateTime()
    }, 1000)

    /* 获取设备信息 */
    device.getInfo({
      success: function(ret) {
        self.deviceModel = ret.model || "未知"
        self.osVersion = (ret.osType || "") + " " + (ret.osVersionName || "")
      }
    })

    /* 读取日志文件，提取累计分配量 */
    file.readText({
      uri: LOG_FILE,
      success: function(data) {
        var text = data.text || ""
        var lines = text.split("\n")
        var allocated = ""

        /* 优先取最终结果行的 "累计分配:" */
        for (var i = 0; i < lines.length; i++) {
          if (lines[i].indexOf("累计分配:") !== -1) {
            allocated = lines[i].replace("累计分配:", "").trim()
          }
        }

        /* 无最终结果，回退到最后一行的 "已分配:" */
        if (!allocated) {
          for (var j = lines.length - 1; j >= 0; j--) {
            if (lines[j].indexOf("已分配:") !== -1) {
              /* 提取 "已分配: N 块 (X.X MB)" 中的 MB 部分 */
              var match = lines[j].match(/\(([^)]+)\)/)
              allocated = match ? match[1] : lines[j].replace(/.*已分配:\s*/, "").trim()
              break
            }
          }
        }

        if (allocated) {
          self.allocatedStr = allocated
        } else {
          self.allocatedStr = "暂无数据"
        }
      },
      fail: function() {
        self.allocatedStr = "读取失败"
      }
    })
  },

  /** 页面销毁：清除定时器 */
  onDestroy() {
    clearInterval(this.timer)
  },

  /** 更新顶栏时钟 */
  updateTime() {
    var d = new Date()
    var hh = ("0" + d.getHours()).slice(-2)
    var mm = ("0" + d.getMinutes()).slice(-2)
    this.nowTime = hh + ":" + mm
  },

  /* ====== 页面跳转 ====== */

  goBack() {
    router.back()
  },
  viewLog() {
    router.push({ uri: "/pages/log" })
  },
  goInfo() {
    router.push({ uri: "/pages/info" })
  }
}
</script>

