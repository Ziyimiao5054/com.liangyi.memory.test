<template>
  <div class="page">

    <!-- 全屏滚动容器 -->
    <scroll id="scrollId" class="content-full" scroll-y="true" bounces="true" onclick="onTxtClick">

      <!-- ========== 方屏顶部栏（条件显示，默认显示）========== -->
      <div show="{{showToolbar}}" class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">日志</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <!-- ========== 胶囊屏顶部栏（条件显示）========== -->
      <div show="{{showToolbar}}" class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <!-- ========== 日志文本 ========== -->
      <div class="text-container">
        <text class="log-text" style="font-size: {{fontSize}}px; line-height: {{lineHeight}}px;">
          {{ logText }}
        </text>
      </div>
    </scroll>

    <!-- ========== 底部工具栏（条件显示） ========== -->
    <img show="{{showToolbar}}" class="bt-bar" src="/common/bt.png" />
    <number_choose show="{{showToolbar}}" class="num-choose"
                   max="50" min="20" step="1" unit="px" value="{{fontSize}}"
                   name="字体大小" @change="onFontChange"></number_choose>
  </div>
</template>

<script>
/* ====== 系统模块导入 ====== */
import router from "@system.router"
import file from "@system.file"

var LOG_FILE = "internal://files/memtest_result.txt"   /* 日志文件路径 */

export default {
  private: {
    nowTime: "00:00",           /* 顶栏时钟 */
    timer: null,                 /* 时钟定时器 */
    logText: "加载中…",         /* 日志文本内容 */
    showToolbar: true,           /* 是否显示顶部/底部工具栏（点击切换） */
    fontSize: 28,                /* 字体大小，默认28px */
    lineHeight: 36               /* 行高，根据字号自动计算 */
  },

  /** 页面初始化：启动时钟、加载日志 */
  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() {
      self.updateTime()
    }, 1000)
    this.loadLog()
  },

  /** 页面销毁：清除定时器 */
  onDestroy() {
    clearInterval(this.timer)
  },

  /** 更新顶栏时钟 */
  updateTime() {
    var d = new Date()
    var hh = ("0" + d.getHours()).slice(-2)
    var mm = ("0" + d.getMinutes()).slice(-2)
    this.nowTime = hh + ":" + mm
  },

  /** 读取日志文件 */
  loadLog() {
    var self = this
    file.readText({
      uri: LOG_FILE,
      success: function(data) {
        self.logText = data.text || ""
      },
      fail: function() {
        self.logText = "无法读取日志文件"
      }
    })
  },

  /** 点击文本区域：切换工具栏显隐（全屏查看日志时隐藏工具栏） */
  onTxtClick() {
    this.showToolbar = !this.showToolbar
  },

  /** 字体大小变更回调：同步更新行高 */
  onFontChange(e) {
    this.fontSize = e.detail.value
    /* 行高 = -0.01 * fontSize² + 1.62 * fontSize - 3.23（二次拟合公式） */
    this.lineHeight = parseInt((-0.01) * (this.fontSize * this.fontSize) + 1.62 * this.fontSize - 3.23)
    if (this.lineHeight < this.fontSize + 4) {
      this.lineHeight = this.fontSize + 4    /* 最低行高保证 */
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
